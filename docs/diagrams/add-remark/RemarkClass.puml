@startuml
' Illustrative AB3 extension only. StudentBook does not implement RemarkCommand.
hide circle
skinparam classAttributeIconSize 0
title Illustrative extension: remark command (unimplemented)

Class "{abstract}\nCommand" as Command {
  +execute(Model): CommandResult
}
Class RemarkCommand {
  +COMMAND_WORD: String
  +MESSAGE_USAGE: String
  +MESSAGE_NOT_IMPLEMENTED_YET: String
  +execute(Model): CommandResult
}
Class CommandException

RemarkCommand -up-|> Command
Command ..> CommandException: throws >
RemarkCommand .right.> CommandException: throws >
@enduml
