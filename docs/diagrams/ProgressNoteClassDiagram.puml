@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeIconSize 0
Class Student
Class ProgressNote {
  date : LocalDate
  text : String
}
Class Lesson
Class Guardian
show ProgressNote fields

Student --> "~* lessons\n{ordered}" Lesson
Student --> "0..1 guardian" Guardian
Student --> "~* notes\n{ordered}" ProgressNote

note right of Student
  Keeps its notes oldest first;
  notes on the same date keep
  the order they were added
end note
@enduml
