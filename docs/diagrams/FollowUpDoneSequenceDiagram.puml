@startuml
!include style.puml
skinparam ArrowFontStyle plain

participant "c:FollowUpDoneCommand" as Command LOGIC_COLOR
participant "m:Model" as Model MODEL_COLOR
participant "student:Student" as Student MODEL_COLOR
participant "r:CommandResult" as Result LOGIC_COLOR

[-> Command : execute(m)
activate Command

Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : students
deactivate Model

note over Command
  Resolve student by studentIndex;
  copy follow-ups and remove item 2
end note

Command -> Student : withFollowUps(followUps)
activate Student
Student --> Command : updated (a new Student)
deactivate Student

Command -> Model : setPerson(student, updated)
activate Model
Model --> Command
deactivate Model

Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : students
deactivate Model

note over Command
  Find updated's new position
  in the filtered students
end note

alt updated is still in students
    create Result
    Command -> Result : CommandResult(feedback,\nupdatedIndex)
    activate Result
    Result --> Command : r
    deactivate Result
else updated left the filtered students
    create Result
    Command -> Result : CommandResult(feedback,\nScreen.STUDENTS)
    activate Result
    Result --> Command : r
    deactivate Result
end

[<-- Command : r
deactivate Command
@enduml
