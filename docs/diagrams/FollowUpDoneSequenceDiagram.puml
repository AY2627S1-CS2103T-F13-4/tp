@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FollowUpDoneCommandParser" as FollowUpDoneCommandParser LOGIC_COLOR
participant "c:FollowUpDoneCommand" as FollowUpDoneCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "s:Student" as OldStudent MODEL_COLOR
participant "updated:Student" as Student MODEL_COLOR
end box

[-> LogicManager : execute("followup-done 1 2")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("followup-done 1 2")
activate AddressBookParser

create FollowUpDoneCommandParser
AddressBookParser -> FollowUpDoneCommandParser : FollowUpDoneCommandParser()
activate FollowUpDoneCommandParser
FollowUpDoneCommandParser --> AddressBookParser
deactivate FollowUpDoneCommandParser

AddressBookParser -> FollowUpDoneCommandParser : parse(" 1 2")
activate FollowUpDoneCommandParser

create FollowUpDoneCommand
FollowUpDoneCommandParser -> FollowUpDoneCommand : FollowUpDoneCommand(1, 2)
activate FollowUpDoneCommand
FollowUpDoneCommand --> FollowUpDoneCommandParser
deactivate FollowUpDoneCommand

FollowUpDoneCommandParser --> AddressBookParser : c
deactivate FollowUpDoneCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
FollowUpDoneCommandParser -[hidden]-> AddressBookParser
destroy FollowUpDoneCommandParser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> FollowUpDoneCommand : execute(m)
activate FollowUpDoneCommand

FollowUpDoneCommand -> Model : getFilteredPersonList()
activate Model
Model --> FollowUpDoneCommand : s
deactivate Model

note right of FollowUpDoneCommand
  Removes item 2 from a copy
  of s's follow-ups
end note

FollowUpDoneCommand -> OldStudent : withFollowUps(remaining)
activate OldStudent
create Student
OldStudent -> Student : Student(..., remaining)
activate Student
Student --> OldStudent
deactivate Student
OldStudent --> FollowUpDoneCommand : updated
deactivate OldStudent

FollowUpDoneCommand -> Model : setPerson(s, updated)
activate Model
Model --> FollowUpDoneCommand
deactivate Model

FollowUpDoneCommand -> Model : getFilteredPersonList()
activate Model
Model --> FollowUpDoneCommand : list
deactivate Model

note right of FollowUpDoneCommand
  If updated is still in the list, the result
  opens it at its new position; otherwise the
  result shows the student list
end note

create CommandResult
FollowUpDoneCommand -> CommandResult : CommandResult("Completed follow-up 2 ...", ...)
activate CommandResult
CommandResult --> FollowUpDoneCommand
deactivate CommandResult

FollowUpDoneCommand --> LogicManager : r
deactivate FollowUpDoneCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
