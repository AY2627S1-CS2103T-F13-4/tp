@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam genericDisplay old

class Lesson
class Subject
class WeeklyLessonSlot
class HourlyRate
class LessonLocation
enum LessonMode <<enumeration>> {
    PHYSICAL
    VIRTUAL
}

show LessonMode members

' These immutable objects may be shared, so the relationships are associations.
Lesson -down-> "1 subject" Subject
Lesson -down-> "1 weeklyLessonSlot" WeeklyLessonSlot
Lesson -down-> "1 hourlyRate" HourlyRate
Lesson -down-> "0..1 location" LessonLocation
Lesson -down-> "0..1 mode" LessonMode

' Keep required fields together, followed by the optional fields.
Subject -[hidden]right- WeeklyLessonSlot
WeeklyLessonSlot -[hidden]right- HourlyRate
HourlyRate -[hidden]right- LessonLocation
LessonLocation -[hidden]right- LessonMode
@enduml
