@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":NoteCommandParser" as NoteCommandParser LOGIC_COLOR
participant "<<class>>\nParserUtil" as ParserUtil LOGIC_COLOR
participant "c:NoteCommand" as NoteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "n:ProgressNote" as ProgressNote MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
participant "updated:Student" as Student MODEL_COLOR
end box

[-> LogicManager : execute("note-add 1 date/2026-10-15 text/Fractions")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(...)
activate AddressBookParser

create NoteCommandParser
AddressBookParser -> NoteCommandParser : NoteCommandParser(ADD)
activate NoteCommandParser
NoteCommandParser --> AddressBookParser
deactivate NoteCommandParser

AddressBookParser -> NoteCommandParser : parse("1 date/2026-10-15 text/Fractions")
activate NoteCommandParser

NoteCommandParser -> ParserUtil : parseProgressNote("2026-10-15", "Fractions", today)
activate ParserUtil
note right of ParserUtil
  Rejects dates that are not
  real or are later than today
end note

create ProgressNote
ParserUtil -> ProgressNote : ProgressNote(2026-10-15, "Fractions")
activate ProgressNote
ProgressNote --> ParserUtil
deactivate ProgressNote

ParserUtil --> NoteCommandParser : n
deactivate ParserUtil

create NoteCommand
NoteCommandParser -> NoteCommand : NoteCommand(1, ADD, n)
activate NoteCommand
NoteCommand --> NoteCommandParser
deactivate NoteCommand

NoteCommandParser --> AddressBookParser : c
deactivate NoteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
NoteCommandParser -[hidden]-> AddressBookParser
destroy NoteCommandParser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> NoteCommand : execute(m)
activate NoteCommand

NoteCommand -> Model : getFilteredPersonList()
activate Model
Model --> NoteCommand : student 1
deactivate Model

create Student
NoteCommand -> Student : Student(..., notes + n)
activate Student
Student --> NoteCommand
deactivate Student
note left of Student
  Sorts its notes
  oldest first
end note

NoteCommand -> Model : setPerson(student 1, updated)
activate Model
Model --> NoteCommand
deactivate Model

create CommandResult
NoteCommand -> CommandResult : CommandResult("Added note 1 ...", 1)
activate CommandResult
CommandResult --> NoteCommand
deactivate CommandResult

NoteCommand --> LogicManager : r
deactivate NoteCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
