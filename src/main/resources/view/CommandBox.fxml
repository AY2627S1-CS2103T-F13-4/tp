<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox styleClass="command-row" alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label text="&gt;" styleClass="command-prompt" />
  <TextField fx:id="commandTextField" onAction="#handleCommandEntered" HBox.hgrow="ALWAYS"
             promptText="Type a command, e.g. list or find alex" />
  <!-- Shortcut hints, shown while the box is empty -->
  <HBox fx:id="keyHints" alignment="CENTER" spacing="6">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
    <Label text="↑↓" styleClass="keycap" />
    <Label text="History" styleClass="key-hint" />
    <Label text="Alt ↑↓" styleClass="keycap" />
    <Label text="Details" styleClass="key-hint" />
    <Label text="PgUp PgDn" styleClass="keycap" />
    <Label text="Scroll" styleClass="key-hint" />
    <Label text="Esc" styleClass="keycap" />
    <Label text="Clear" styleClass="key-hint" />
    <Label text="F1" styleClass="keycap" />
    <Label text="Help" styleClass="key-hint" />
  </HBox>
</HBox>
