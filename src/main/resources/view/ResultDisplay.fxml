<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="resultRow" styleClass="result-row" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="resultIcon" styleClass="result-icon" />
  <!-- Grows with the message up to maxHeight, then scrolls (e.g. long command usage at small sizes) -->
  <ScrollPane fx:id="resultScroll" styleClass="result-scroll" fitToWidth="true" hbarPolicy="NEVER"
              focusTraversable="false" minHeight="0" maxHeight="132" HBox.hgrow="ALWAYS">
    <VBox fx:id="resultContent" spacing="5" />
  </ScrollPane>
</HBox>
