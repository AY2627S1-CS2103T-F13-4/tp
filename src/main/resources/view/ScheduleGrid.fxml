<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="scheduleGrid" gridLinesVisible="true" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints hgrow="NEVER" minWidth="50.0"/> <!-- Timestamps -->
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="30.0" vgrow="NEVER" /> <!-- Days -->
  </rowConstraints>
</GridPane>
