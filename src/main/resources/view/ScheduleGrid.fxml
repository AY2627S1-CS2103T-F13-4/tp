<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="scheduleGrid" styleClass="schedule-grid" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints hgrow="NEVER" minWidth="76.0" prefWidth="76.0"/> <!-- Times -->
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="36.0" vgrow="NEVER" /> <!-- Days -->
  </rowConstraints>
</GridPane>
