<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- One table row per student: # | Student | Lessons | Guardian. Column widths are bound by PersonListPanel. -->
<HBox id="cardPane" fx:id="cardPane" styleClass="student-row" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="id" styleClass="row-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>

  <VBox fx:id="studentCell" spacing="6">
    <HBox alignment="CENTER_LEFT" spacing="10">
      <Label fx:id="initials" styleClass="initials-badge">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Text fx:id="name" text="\$first" styleClass="row-name" />
      <Label fx:id="schoolingLevel" text="\$schoolingLevel" styleClass="chip">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
    </HBox>
    <FlowPane fx:id="badges" hgap="6" vgap="6" />
    <Text fx:id="contact" styleClass="row-muted" />
    <Text fx:id="address" text="\$address" styleClass="row-muted" />
    <!-- Shown instead of the Guardian column in narrow windows -->
    <Text fx:id="guardianInline" styleClass="row-muted" />
  </VBox>

  <VBox fx:id="lessons" />

  <VBox fx:id="guardianCell" spacing="2">
    <Text fx:id="guardianName" styleClass="row-value" />
    <Text fx:id="guardianPhone" styleClass="row-muted" />
  </VBox>
</HBox>
