<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Details are shown in the sidebar; selecting a card never expands the list row. -->
<HBox styleClass="student-row, row-line" alignment="CENTER_LEFT" minWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="id" styleClass="row-index" minWidth="-Infinity" />
  <HBox alignment="CENTER_LEFT" spacing="10" minWidth="0">
    <Label fx:id="initials" styleClass="initials-badge" minWidth="-Infinity" />
    <VBox fx:id="summary" spacing="4" minWidth="0">
      <FlowPane hgap="8" vgap="3" minWidth="0" prefWrapLength="0">
        <Label fx:id="name" styleClass="student-name" wrapText="true" minWidth="0"
               maxWidth="${summary.width}" />
        <Label fx:id="schoolingLevel" styleClass="student-level" wrapText="true" minWidth="0"
               maxWidth="${summary.width}" />
      </FlowPane>
      <Label fx:id="subjects" styleClass="student-subjects" wrapText="true" minWidth="0" />
    </VBox>
  </HBox>
</HBox>
