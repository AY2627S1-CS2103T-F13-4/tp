<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox id="cardPane" fx:id="cardPane" styleClass="student-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="id" styleClass="card-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <VBox spacing="8" minWidth="0" HBox.hgrow="ALWAYS">
    <Text fx:id="name" text="\$first" styleClass="card-name" />
    <HBox fx:id="badges" alignment="CENTER_LEFT" spacing="6">
      <Label fx:id="schoolingLevel" text="\$schoolingLevel" styleClass="chip, level-chip">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <FlowPane fx:id="tags" hgap="6" vgap="6" HBox.hgrow="ALWAYS" />
    </HBox>
    <!-- Numbered so that the numbers match LESSON_INDEX in lesson-edit and lesson-delete -->
    <VBox fx:id="lessons" spacing="3">
      <Label text="Lessons" styleClass="fact-caption" />
    </VBox>
    <!-- Each fact keeps its caption above the value; facts wrap onto new rows in narrow windows -->
    <FlowPane fx:id="facts" hgap="32" vgap="10">
      <VBox spacing="2">
        <Label text="Guardian" styleClass="fact-caption" />
        <Label fx:id="guardian" text="\$guardian" styleClass="fact-value" />
      </VBox>
      <VBox spacing="2">
        <Label text="Phone" styleClass="fact-caption" />
        <Label fx:id="phone" text="\$phone" styleClass="fact-value" />
      </VBox>
      <VBox spacing="2">
        <Label text="Email" styleClass="fact-caption" />
        <Label fx:id="email" text="\$email" styleClass="fact-value" />
      </VBox>
      <VBox spacing="2">
        <Label text="Address" styleClass="fact-caption" />
        <Text fx:id="address" text="\$address" styleClass="fact-value" />
      </VBox>
    </FlowPane>
  </VBox>
</HBox>
