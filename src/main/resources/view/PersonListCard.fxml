<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- One row per student: # | Student | Next lesson | Guardian. Column widths are bound by PersonListPanel.
     The details below the row are shown only when the row is expanded. -->
<VBox fx:id="cardPane" styleClass="student-row" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox styleClass="row-line" alignment="CENTER_LEFT">
    <Label fx:id="id" styleClass="row-index">
      <minWidth>
        <!-- Ensures that the label text is never truncated -->
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <HBox fx:id="studentCell" alignment="CENTER_LEFT" spacing="10">
      <Label fx:id="initials" styleClass="initials-badge">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Text fx:id="name" text="\$first" styleClass="row-name" />
      <Label fx:id="schoolingLevel" text="\$schoolingLevel" styleClass="chip">
        <minWidth>
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
    </HBox>
    <HBox fx:id="nextLessonCell" alignment="CENTER_LEFT" spacing="8">
      <Text fx:id="nextSubject" styleClass="lesson-subject" />
      <Text fx:id="nextTime" styleClass="row-secondary" />
      <Text fx:id="moreLessons" styleClass="row-muted" />
    </HBox>
    <HBox fx:id="guardianCell" alignment="CENTER_LEFT">
      <Text fx:id="guardianName" styleClass="row-secondary" />
    </HBox>
  </HBox>

  <!-- Expanded details: every lesson, contact details, guardian and tags -->
  <FlowPane fx:id="details" styleClass="row-details" hgap="48" vgap="16" />
</VBox>
