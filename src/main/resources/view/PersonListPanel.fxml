<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="list-section" minHeight="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox alignment="BASELINE_LEFT" spacing="10">
    <Label text="Students" styleClass="view-title" />
    <Label fx:id="listSummary" styleClass="view-subtitle" />
  </HBox>
  <StackPane styleClass="list-card" minHeight="0" VBox.vgrow="ALWAYS">
    <VBox minHeight="0">
      <!-- Column headings; their widths are bound to the same columns as each row -->
      <HBox fx:id="columnHeader" styleClass="table-header">
        <Label text="#" styleClass="table-heading, heading-index" />
        <Label fx:id="studentHeading" text="Student" styleClass="table-heading" />
        <Label fx:id="lessonsHeading" text="Next lesson" styleClass="table-heading" />
        <Label fx:id="guardianHeading" text="Guardian" styleClass="table-heading" />
      </HBox>
      <ListView fx:id="personListView" minHeight="0" VBox.vgrow="ALWAYS" />
    </VBox>
  </StackPane>
</VBox>
